---
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { type Lang, localeMap, hreflangMap, dictionaries, defaultLang, getTranslation } from '../i18n/ui';
import { WHATSAPP_NUMBER, DOMAIN } from '../lib/constants';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const lang = Astro.props.lang ?? defaultLang;
const {
  title = getTranslation(lang, 'seo.title'),
  description = getTranslation(lang, 'seo.description'),
  ogImage = `${DOMAIN}/assets/THEBRANDCREW_model2.png`,
  noindex = false
} = Astro.props;

const canonicalURL = Astro.props.canonicalURL || Astro.url;

const seo = dictionaries[lang].seo;
const pricing = dictionaries[lang].pricing;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "The Brand Crew",
  "description": seo.businessDescription,
  "url": DOMAIN,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mar del Plata",
    "addressRegion": "Buenos Aires",
    "addressCountry": "AR"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+54-9-11-2406-3009",
    "contactType": "sales",
    "availableLanguage": ["English", "Spanish"]
  },
  "sameAs": [
    "https://github.com/illushkinn",
    `https://wa.me/${WHATSAPP_NUMBER}`
  ],
  "foundingDate": "2026",
  "founder": {
    "@type": "Person",
    "name": "Illya Grytsyk"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Essential — Web Design",
      "description": "Landing or single-page site, 5 sections, responsive, basic SEO",
      "price": "300.00",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Crew — Web Design",
      "description": "Multi-section site that sells, copywriting, local SEO, 30-day support",
      "price": "600.00",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "MVP / E-commerce",
      "description": "Custom e-commerce or MVP, integrations, WhatsApp chatbot",
      "price": "1000.00",
      "priceCurrency": "USD"
    }
  ],
  "knowsAbout": ["Web Design", "Web Development", "SEO", "E-commerce", "UI/UX Design"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a3')
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "The Brand Crew",
  "url": DOMAIN,
  "description": seo.websiteDescription,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${DOMAIN}/?s={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const altLang: Lang = lang === 'es' ? 'en' : 'es';
---

<!DOCTYPE html>
<html lang={localeMap[lang]}>
<head>
  <meta charset="UTF-8">
  <script is:inline>history.scrollRestoration='manual';</script>
  <meta name="color-scheme" content="light dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f4f7">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#c47a68">
  <meta name="google-site-verification" content="k-kPS76zKdKwT-18dhJwvxuK56oZXsaMpiBEeOmjuQA" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content="The Brand Crew">
  <meta property="og:title" content={seo.ogTitle}>
  <meta property="og:description" content={seo.ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={seo.ogImageAlt}>
  <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={seo.ogTitle}>
  <meta name="twitter:description" content={seo.ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={seo.ogImageAlt}>

  <link rel="canonical" href={canonicalURL}>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>

  <!-- Hreflang -->
  {(() => {
    const pathname = typeof canonicalURL === 'string' ? new URL(canonicalURL).pathname : canonicalURL.pathname || '/';
    const esHref = pathname.startsWith('/en/') ? pathname.replace('/en/', '/') : pathname;
    const enHref = pathname.startsWith('/en/') ? pathname : '/en' + pathname;
    return (
      <>
        <link rel="alternate" hreflang="es" href={esHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang={hreflangMap[lang]} href={canonicalURL} />
      </>
    );
  })()}

  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://va.vercel-scripts.com">
  <!-- Google Fonts: non-blocking via media="print" + onload swap -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>


  <!-- Vercel Speed Insights -->
  <script defer src="/_vercel/speed-insights/script.js"></script>
  <!-- Vercel Analytics -->
  <script defer src="/_vercel/insights/script.js"></script>

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">{lang === 'es' ? 'Ir al contenido' : 'Skip to main content'}</a>
  <Navbar lang={lang} />
  <MobileMenu lang={lang} />
  <slot />
  <script src="../scripts/navigation.js"></script>
  <script src="../scripts/scroll.js"></script>
  <script src="../scripts/reveal.js"></script>
</body>
</html>
