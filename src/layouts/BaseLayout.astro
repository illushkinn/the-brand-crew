---
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { type Lang, localeMap, hreflangMap, dictionaries, defaultLang, getTranslation } from '../i18n/ui';
import { WHATSAPP_NUMBER, DOMAIN } from '../lib/constants';
import { translatedPaths, ES_ONLY_PATHS } from '../lib/routing';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  breadcrumb?: Array<{ name: string; url: string }>;
  /** Explicit hreflang alternates (absolute or root-relative). Omit a lang if the page has no twin. */
  alternates?: Partial<Record<Lang, string>>;
  /** Emit the home FAQPage schema (only where those questions are visible). */
  homeFaq?: boolean;
}

const lang = Astro.props.lang ?? defaultLang;
const {
  title = getTranslation(lang, 'seo.title'),
  description = getTranslation(lang, 'seo.description'),
  ogImage = `${DOMAIN}/assets/THEBRANDCREW_model2.webp`,
  noindex = false,
  breadcrumb,
  homeFaq = false,
} = Astro.props;

const canonicalURL = String(Astro.props.canonicalURL || new URL(Astro.url.pathname, DOMAIN));

// Open Graph: page-specific title/description; the home falls back to the curated OG copy.
const isDefaultTitle = !Astro.props.title;
const ogTitle = isDefaultTitle ? dictionaries[lang].seo.ogTitle : title;
const ogDescription = isDefaultTitle ? dictionaries[lang].seo.ogDescription : description;

// Hreflang: absolute URLs, only for pages that really exist in each language.
// translatedPaths maps ES paths whose EN twin has a different slug (e.g. /servicios/diseno-web).
const abs = (path: string) => (path.startsWith('http') ? path : path === '/' ? `${DOMAIN}/` : `${DOMAIN}${path}`);
const computeAlternates = (): Partial<Record<Lang, string>> => {
  if (Astro.props.alternates) return Astro.props.alternates;
  const pathname = new URL(canonicalURL).pathname.replace(/\/$/, '') || '/';
  const esPath = /^\/en(\/|$)/.test(pathname)
    ? (Object.entries(translatedPaths).find(([, en]) => en === pathname)?.[0] ?? (pathname.replace(/^\/en/, '') || '/'))
    : pathname;
  if (ES_ONLY_PATHS.includes(esPath) || esPath.startsWith('/guias')) return { es: esPath }; // ES-only content
  const enPath = translatedPaths[esPath] ?? (esPath === '/' ? '/en' : `/en${esPath}`);
  return { es: esPath, en: enPath };
};
const alternates = noindex ? {} : computeAlternates();

const seo = dictionaries[lang].seo;
const pricing = dictionaries[lang].pricing;

const jsonLdPrice = (value: string): string => `${value.replace(/[.,]/g, '')}.00`;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${DOMAIN}/#business`,
  "name": "The Brand Crew",
  "alternateName": "The Brand Crew Agencia Creativa Argentina",
  "description": seo.businessDescription,
  "areaServed": [
    { "@type": "City", "name": "Mar del Plata" },
    { "@type": "Country", "name": "Argentina" }
  ],
  "url": DOMAIN,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mar del Plata",
    "addressRegion": "Buenos Aires",
    "addressCountry": "AR"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+${WHATSAPP_NUMBER}`,
    "contactType": "sales",
    "availableLanguage": ["English", "Spanish"]
  },
  "telephone": `+${WHATSAPP_NUMBER}`,
  "image": `${DOMAIN}/assets/THEBRANDCREW_model2.webp`,
  "logo": `${DOMAIN}/favicon.svg`,
  "priceRange": "USD 1500 - 4500",
  "sameAs": [
    "https://www.instagram.com/the.brand.crew/",
    "https://www.facebook.com/profile.php?id=61594039034101",
    "https://x.com/thebrandcrew_",
    "https://substack.com/@thebrandcrew",
    "https://github.com/illushkinn"
  ],
  "foundingDate": "2026",
  "founder": {
    "@type": "Person",
    "name": "Illya Grytsyk"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Essential — Online Launch",
      "description": "Custom 1-page landing + logo & brand palette + launch content pack. Built by a senior dev and a graphic designer.",
      "price": jsonLdPrice(pricing.esencialPrice),
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Crew — Growth Partner",
      "description": "Custom multi-section website + full brand identity + 30-day organic content pack, sales copy and local SEO.",
      "price": jsonLdPrice(pricing.crewPrice),
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "MVP / E-commerce",
      "description": "Custom e-commerce + premium branding + 90 days of content, WhatsApp automation and frictionless card payments.",
      "price": jsonLdPrice(pricing.mvpPrice),
      "priceCurrency": "USD"
    }
  ],
  "knowsAbout": ["Web Design", "Growth Marketing", "Brand Design", "Content Strategy", "SEO", "E-commerce", "UI/UX Design", "Branding", "Graphic Design", "Content Creation"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": getTranslation(lang, 'faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": getTranslation(lang, 'faq.a4')
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${DOMAIN}/#website`,
  "name": "The Brand Crew",
  "url": DOMAIN,
  "description": seo.websiteDescription,
  "inLanguage": localeMap[lang],
  "publisher": { "@id": `${DOMAIN}/#business` }
};

const breadcrumbUrl = (path: string): string => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  const basePath = normalized.replace(/^\/en(?=\/|$)/, '') || '/';
  if (basePath === '/') {
    return lang === 'en' ? `${DOMAIN}/en` : `${DOMAIN}/`;
  }
  return lang === 'en' ? `${DOMAIN}/en${basePath}` : `${DOMAIN}${basePath}`;
};

const breadcrumbSchema =
  breadcrumb && breadcrumb.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumb.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": item.name,
          "item": breadcrumbUrl(item.url)
        }))
      }
    : undefined;
---

<!DOCTYPE html>
<html lang={localeMap[lang]}>
<head>
  <meta charset="UTF-8">
  <script is:inline>history.scrollRestoration='manual';</script>
  <meta name="color-scheme" content="light dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0f15">
  <meta name="google-site-verification" content="k-kPS76zKdKwT-18dhJwvxuK56oZXsaMpiBEeOmjuQA" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content="The Brand Crew">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={seo.ogImageAlt}>
  <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={seo.ogImageAlt}>

  <link rel="canonical" href={canonicalURL}>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>

  <!-- Hreflang — URLs absolutas, self-ref única por idioma, x-default al
       ES (default). Solo emite el twin EN si esa página existe (las guías
       /guias no tienen versión /en — emitirla generaba un alternate 404). -->
  {alternates.es && <link rel="alternate" hreflang={hreflangMap[defaultLang]} href={abs(alternates.es)} />}
  {alternates.en && <link rel="alternate" hreflang={hreflangMap['en']} href={abs(alternates.en)} />}
  {alternates.es && <link rel="alternate" hreflang="x-default" href={abs(alternates.es)} />}

  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>
  {homeFaq && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://va.vercel-scripts.com">
  <!-- Preload critical font: Onest latin is a single variable file covering BOTH
       body (font-weight: 400) and headings (font-weight: 500) — see src/styles/fonts.css -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/onest-latin.woff2" crossorigin>
  <!-- Preload hero logo SVG -->
  <link rel="preload" as="image" href="/assets/THEBRANDCREW_model1_dark.svg">


  <!-- Vercel Speed Insights -->
  <script defer src="/_vercel/speed-insights/script.js"></script>
  <!-- Vercel Analytics -->
  <script defer src="/_vercel/insights/script.js"></script>

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">{lang === 'es' ? 'Ir al contenido' : 'Skip to main content'}</a>
  <Navbar lang={lang} />
  <MobileMenu lang={lang} />
  <main id="main-content" class="page-content">
    <slot />
  </main>
  <script src="../scripts/navigation.js"></script>
  <script src="../scripts/scroll.js"></script>
  <script src="../scripts/reveal.js"></script>
  <!-- Lazy-load cursor.js: solo en desktop (pointer: fine) -->
  <script is:inline>
    if (window.matchMedia('(pointer: fine)').matches) {
      const s = document.createElement('script');
      s.src = '/scripts/cursor.js';
      s.defer = true;
      document.body.appendChild(s);
    }
  </script>
  <CookieBanner lang={lang} />
</body>
</html>
