---
// PricingPage.astro — presentational shell for /pricing (both langs)
import type { Lang } from '../i18n/ui';
import { dictionaries } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pricing from './Pricing.astro';
import CTA from './CTA.astro';
import Footer from './Footer.astro';
import ScrollToTop from './ScrollToTop.astro';

interface Props {
  lang?: Lang;
  canonicalURL?: string;
}
const { lang = 'es', canonicalURL } = Astro.props;
const p = dictionaries[lang].pricing;
---

<BaseLayout lang={lang} title={p.metaTitle} description={p.metaDescription} canonicalURL={canonicalURL}>
  <div class="pricing-page-content">
    <Pricing lang={lang} />
  </div>
  <CTA lang={lang} />
  <Footer lang={lang} />
  <ScrollToTop lang={lang} />
</BaseLayout>