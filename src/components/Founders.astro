---
// Founders.astro - Founding partners cards
import type { Lang } from '../i18n/ui';
import { useTranslations, dictionaries } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const skills = dictionaries[lang].founders;
---

<section class="section founders reveal-stagger" id="crew" aria-label="The crew">
  <h2 class="section-title rv">{t('founders.title1')} <span class="text-accent">{t('founders.title2')}</span>.</h2>
  <div class="founders-grid">

    <article class="glass-card founder-card rv">
      <span class="founder-index mono" aria-hidden="true">01</span>
      <div class="founder-avatar img-avatar">
        <img src="/assets/profile-11.png" alt="Illya Grytsyk" width="56" height="56" loading="lazy" />
      </div>
      <div class="founder-info">
        <span class="mono founder-role">{t('founders.illyaRole')}</span>
        <h3 class="founder-name">Illya Grytsyk</h3>
        <p class="founder-bio">{t('founders.illyaBio')}</p>
        <ul class="founder-skills">
          {skills.illyaSkills.map((skill: string) => <li>{skill}</li>)}
        </ul>
      </div>
    </article>

    <article class="glass-card founder-card accent-terracota rv">
      <span class="founder-index mono" aria-hidden="true">02</span>
      <div class="founder-avatar letter-avatar">
        C
      </div>
      <div class="founder-info">
        <span class="mono founder-role">{t('founders.carlosRole')}</span>
        <h3 class="founder-name">Carlos Segovia Gonzalez</h3>
        <p class="founder-bio">{t('founders.carlosBio')}</p>
        <ul class="founder-skills">
          {skills.carlosSkills.map((skill: string) => <li>{skill}</li>)}
        </ul>
      </div>
    </article>

  </div>
</section>