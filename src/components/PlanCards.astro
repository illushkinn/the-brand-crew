---
// PlanCards.astro — tarjetas de planes (Arrancá, Crecé, Escalá) compartidas por /pricing y /socios
import type { Lang } from '../i18n/ui';
import { dictionaries } from '../i18n/ui';
import Icon from './Icon.astro';
import { getWhatsAppLink } from '../lib/whatsapp';
import { getGrowthPartnerLink } from '../lib/routing';

interface Props {
  lang?: Lang;
  showBadge?: boolean;
  badge?: string;
  titleHeading?: 'h2' | 'h3';
}
const { lang = 'es', showBadge = false, badge, titleHeading = 'h3' } = Astro.props;
const p = dictionaries[lang].pricing;
const Heading = titleHeading;
const STAR_INDEX = 1;

const plans = [
  { name: p.esencialTitle, price: p.esencialPrice, tagline: p.esencialTagline, features: p.esencialFeatures },
  { name: p.crewTitle, price: p.crewPrice, tagline: p.crewTagline, features: p.crewFeatures },
  { name: p.mvpTitle, price: p.mvpPrice, tagline: p.mvpTagline, features: p.mvpFeatures },
];
---

<div class="plan-grid">
  {
    plans.map((plan, i) => {
      const message = p.planCtaMessage.replace('{plan}', plan.name);
      return (
        <article class:list={['plan-card', { 'is-star': i === STAR_INDEX }]}>
          <div class="plan-card-top">
            <Heading class="plan-name mono">{plan.name}</Heading>
            {showBadge && badge && i === STAR_INDEX && <span class="plan-badge mono">{badge}</span>}
          </div>
          <p class="plan-price">
            <span class="plan-currency">$</span>
            {plan.price}
            <span class="plan-usd">USD</span>
          </p>
          <p class="plan-tagline">{plan.tagline}</p>
          <ul class="plan-features">
            {plan.features.map((f) => <li>{f}</li>)}
          </ul>
          <a
            href={getWhatsAppLink(lang, message)}
            class="plan-cta"
            data-wa-message={message}
            target="_blank"
            rel="noopener"
          >
            {p.planCta}
            <Icon name="arrow-right" size={16} strokeWidth={2.5} />
          </a>
        </article>
      );
    })
  }
</div>

<p class="plan-footnote">{p.planFootnote}</p>

<p class="plan-growth">
  {p.planGrowthText}
  <a href={getGrowthPartnerLink(lang)}>{p.planGrowthLink} →</a>
</p>

<script is:inline define:vars={{ refLabel: p.planRefLabel }}>
  // Links con ?ref=<nombre> (setters): se agrega al mensaje de WhatsApp para atribuir el lead.
  (() => {
    const ref = new URLSearchParams(location.search).get('ref');
    if (!ref) return;
    const clean = ref.replace(/[^\p{L}\p{N} _.-]/gu, '').slice(0, 40);
    if (!clean) return;
    document.querySelectorAll('a[data-wa-message]').forEach((a) => {
      const url = new URL(a.href);
      url.searchParams.set('text', `${a.dataset.waMessage} (${refLabel}: ${clean})`);
      a.href = url.toString();
    });
  })();
</script>

<style>
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.3s, transform 0.3s cubic-bezier(0.2, 0, 0, 1);
  }
  .plan-card:hover {
    border-color: var(--glass-border);
    transform: translateY(-2px);
  }
  .plan-card.is-star {
    border-color: oklch(0.58 0.18 32 / 0.55);
    box-shadow: 0 8px 40px oklch(0.58 0.18 32 / 0.14);
  }
  .plan-card.is-star::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 2rem;
    right: 2rem;
    height: 2px;
    background: var(--terracota);
    border-radius: 2px;
  }

  .plan-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 1.5rem;
  }
  .plan-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--body-dim);
    margin: 0;
  }
  .plan-badge {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terracota);
    padding: 0.25rem 0.6rem;
    border: 1px solid oklch(0.58 0.18 32 / 0.45);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .plan-price {
    display: flex;
    align-items: flex-start;
    margin: 1.75rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--headline);
  }
  .is-star .plan-price {
    color: var(--headline);
  }
  .plan-currency {
    font-size: 0.5em;
    font-weight: 500;
    margin: 0.2em 0.08em 0 0;
    opacity: 0.7;
  }
  .plan-usd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    margin: 0.5em 0 0 0.5rem;
    color: var(--body-dim);
  }

  .plan-tagline {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--headline);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
  }
  .plan-features li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--body);
  }
  .plan-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: var(--radius-round);
    background: var(--verde);
  }

  .plan-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    background: var(--terracota);
    border: 1px solid var(--terracota);
    border-radius: 10px;
    font-weight: 500;
    color: var(--white);
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .plan-cta:hover {
    background: var(--terracota-hover);
    border-color: var(--terracota-hover);
    color: var(--white);
  }
  .plan-cta:focus-visible {
    outline: 2px solid var(--verde);
    outline-offset: 2px;
  }

  .plan-footnote {
    margin-top: 2rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--body-dim);
  }
  .plan-growth {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--body-dim);
  }
  .plan-growth a {
    color: var(--headline);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }
  .plan-growth a:hover {
    color: var(--verde);
  }

  @media (max-width: 900px) {
    .plan-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin: 0 auto;
    }
    .plan-card.is-star {
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-card,
    .plan-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
