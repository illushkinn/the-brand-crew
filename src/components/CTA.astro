---
// CTA.astro - Final call-to-action
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { CALENDLY_URL } from '../lib/constants';
import { getWhatsAppLink } from '../lib/whatsapp';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const waLink = getWhatsAppLink(lang);
---

<section class="cta-final reveal" id="contacto" aria-label="Contact">
  <div class="cta-content">
    <h2><span class="cta-dale">{t('cta.title1')}</span>{t('cta.title2') && <span class="text-terracota cta-empecemos"> {t('cta.title2')}</span>}.</h2>
    <button type="button" class="btn btn-lg btn-premium cta-btn" data-calendly-url={CALENDLY_URL}>
      {t('cta.schedule')}
    </button>
    <p class="cta-secondary">
      {t('cta.preferWp')} <a href={waLink} target="_blank" rel="noopener">{t('cta.whatsappAlt')}</a>
    </p>
  </div>
</section>

<script>
  // Calendly popup trigger — event delegation (sobrevive view transitions).
  // Guard: con View Transitions el document persiste, así que el listener
  // solo se registra una vez por sesión.
  if (!window.__calendlyBound) {
    window.__calendlyBound = true;
    document.addEventListener('click', function (e) {
      const trigger = (e.target as HTMLElement).closest('[data-calendly-url]') as HTMLElement | null;
      if (!trigger) return;
      const url = trigger.dataset.calendlyUrl;
      if (!url) return;
      e.preventDefault();
      if (window.Calendly) {
        window.Calendly.initPopupWidget({ url });
        return;
      }
      // Lazy-load el widget de Calendly la primera vez que se clickea
      const s = document.createElement('script');
      s.src = 'https://assets.calendly.com/assets/external/widget.js';
      s.async = true;
      s.onload = function () {
        window.Calendly.initPopupWidget({ url });
      };
      document.body.appendChild(s);
    });
  }
</script>