---
// CTA.astro - Final call-to-action
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { WHATSAPP_NUMBER } from '../lib/constants';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=` + encodeURIComponent(
  lang === 'es'
    ? '¡Hola The Brand Crew! Vi tu sitio y me encantaría trabajar con ustedes.'
    : "Hey The Brand Crew! I saw your site and I'd love to work with you."
);
---

<section class="cta-final reveal" id="contacto" aria-label="Contact">
  <div class="cta-content">
    <h2><span class="cta-dale">{t('cta.title1')}</span>{t('cta.title2') && <span class="text-terracota cta-empecemos"> {t('cta.title2')}</span>}.</h2>
    <a href={waLink} target="_blank" rel="noopener" class="btn btn-lg btn-premium cta-btn">{lang === 'es' ? 'Hablemos por WhatsApp' : 'Chat on WhatsApp'}</a>
  </div>
</section>