---
// Logo.astro - The Brand Crew isotype
// SOURCE: public/assets/THEBRANDCREW_model1.svg (CorelDRAW export)
interface Props {
  size?: number;
  ariaLabel?: string;
}
const { size = 40, ariaLabel = 'The Brand Crew' } = Astro.props;
---

<span class="logo-wrap">
  <img
    src="/assets/THEBRANDCREW_model1_dark.svg"
    alt={ariaLabel}
    width={size}
    height={size}
    class="logo-isotype"
    loading="eager"
  />
</span>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-isotype {
    display: block;
    flex-shrink: 0;
  }
</style>
