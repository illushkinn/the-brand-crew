---
// Logo.astro - The Brand Crew isotype
// SOURCE: public/assets/THEBRANDCREW_model1.svg (CorelDRAW export)
interface Props {
  size?: number;
  className?: string;
  showWordmark?: boolean;
  ariaLabel?: string;
  text?: string;
}
const { size = 40, className = '', showWordmark = false, ariaLabel = 'The Brand Crew', text = '' } = Astro.props;
---

<span class={`logo-wrap ${showWordmark ? 'with-wordmark' : ''} ${className}`}>
  <img
    src="/assets/THEBRANDCREW_model1.svg"
    alt={ariaLabel}
    width={size}
    height={size}
    class="logo-isotype"
    loading="eager"
  />
  {showWordmark && <span class="logo-wordmark">{text || 'The Brand Crew'}</span>}
</span>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-isotype {
    display: block;
    flex-shrink: 0;
  }
  .logo-wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--headline);
    white-space: nowrap;
  }
  @media (max-width: 767.98px) {
    .logo-wordmark {
      display: none;
    }
  }
</style>
