---
// About section - Company description
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section about reveal" id="about" aria-label="About us">
  <span class="section-label mono text-terracota">{t('about.kicker')}</span>
  <h2 class="section-title">{t('about.title1')} <span class="text-terracota">{t('about.title2')}</span>.</h2>
  <div class="glass-card about-card">
    <p class="about-text">
      {t('about.text')}
    </p>
  </div>
</section>