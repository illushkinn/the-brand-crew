---
// ComoFunciona.astro - How it works section with 3 step cards
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section como-funciona reveal-stagger" id="resultados" aria-label="Solution">
  <span class="section-label mono text-verde rv">{t('comoFunciona.kicker')}</span>
  <h2 class="section-title rv">{t('comoFunciona.title1')}<br><span class="text-verde">{t('comoFunciona.title2')}</span>.</h2>
  <p class="section-sub rv" set:html={t('comoFunciona.sub')}></p>
  <div class="como-funciona-grid rv">
    <div class="glass-card como-funciona-card">
      <h3>{t('comoFunciona.step1Title')}</h3>
      <p>{t('comoFunciona.step1Text')}</p>
    </div>
    <div class="glass-card como-funciona-card">
      <h3>{t('comoFunciona.step2Title')}</h3>
      <p>{t('comoFunciona.step2Text')}</p>
    </div>
    <div class="glass-card como-funciona-card">
      <h3>{t('comoFunciona.step3Title')}</h3>
      <p>{t('comoFunciona.step3Text')}</p>
    </div>
  </div>
</section>
