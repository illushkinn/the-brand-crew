---
// Pricing.astro - Pricing section: plan cards (web + marca + contenido) + link to Growth Partner
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { DOMAIN } from '../lib/constants';
import PlanCards from './PlanCards.astro';
import { getHomeLink } from '../lib/routing';

interface Props {
  lang?: Lang;
  showBackLink?: boolean;
  heading?: 'h1' | 'h2';
}
const { lang = 'es', showBackLink = false, heading = 'h2' } = Astro.props;
const t = useTranslations(lang);
const titleHeading = heading;

const homeLink = `${DOMAIN}${getHomeLink(lang)}`;
---

<section class="section pricing reveal-stagger" id="precios" aria-label="Pricing">
  {showBackLink && <a href={homeLink} class="pricing-back-link">{t('pricing.backToHome')}</a>}
  {titleHeading === 'h1' ? (
    <h1 class="section-title rv">{t('pricing.title1')}.</h1>
  ) : (
    <h2 class="section-title rv">{t('pricing.title1')}.</h2>
  )}

  <div class="rv pricing-kit">
    <p class="pricing-kit-title mono">{t('pricing.kit1Title')}</p>
    <PlanCards lang={lang} showBadge={true} badge={t('socios.badge')} titleHeading={titleHeading === 'h1' ? 'h2' : 'h3'} />
  </div>

  <div class="rv discovery-strip">
    <p class="discovery-title mono">{t('pricing.discoveryTitle')}</p>
    <p class="discovery-text">{t('pricing.discoveryText')}</p>
    <ul class="discovery-chips" aria-label="Google · ChatGPT">
      <li class="tag-b2b tag-outline">Google</li>
      <li class="tag-b2b tag-outline">ChatGPT</li>
    </ul>
  </div>

  {lang === 'es' && (
    <p class="pricing-note rv">
      ¿Antes de pedir presupuesto? Leé <a href="/guias/cuanto-cuesta-una-pagina-web-en-argentina">cuánto cuesta realmente una página web en Argentina</a> — rangos de referencia, qué incluye cada tramo y los errores que más plata cuestan al cotizar.
    </p>
  )}
</section>

<style>
  .discovery-strip {
    max-width: 620px;
    margin: 3rem auto 0;
    padding: 1.5rem 2rem;
    text-align: center;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--banner-bg);
  }
  .discovery-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--charcoal);
    margin-bottom: 0.75rem;
  }
  .discovery-text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }
  .discovery-chips {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin-top: 1rem;
  }
  .pricing-note {
    max-width: 620px;
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--body-dim);
  }
  .pricing-note a {
    color: var(--terracota);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .pricing-note a:hover {
    color: var(--terracota-hover);
  }
</style>
