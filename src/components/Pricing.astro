---
// Pricing.astro - Pricing section: Kit 1 (Web Design) + link to Growth Partner
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import PricingKit1 from './PricingKit1.astro';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const growthLink = lang === 'es' ? '/pricing/growth-partner' : '/en/pricing/growth-partner';
---

<section class="section pricing reveal" id="precios" aria-label="Pricing">
  <span class="section-label mono text-terracota">{t('pricing.kicker')}</span>
  <h2 class="section-title">{t('pricing.title1')} <span class="text-verde">{t('pricing.title2')}</span>.</h2>

  <PricingKit1 lang={lang} />

  <!-- Growth Partner CTA -->
  <div class="pricing-growth-cta">
    <p class="pricing-growth-cta-text">{t('pricing.growthCtaText')}</p>
    <a href={growthLink} class="btn btn-outline">
      {t('pricing.growthCtaLink')}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <p class="pricing-monotributo-note">
    {t('pricing.monotributoNote')}
  </p>
</section>
