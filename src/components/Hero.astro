---
// Hero.astro — 50/50 split: left = pitch, right = logo composition
import Logo from './Logo.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { WHATSAPP_NUMBER } from '../lib/constants';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=` + encodeURIComponent(
  lang === 'es'
    ? '¡Hola The Brand Crew! Vi tu sitio y me encantaría trabajar con ustedes.'
    : "Hey The Brand Crew! I saw your site and I'd love to work with you."
);
const ctaLabel = t('hero.cta');
---

<div class="hero-problema-wrap" id="home">
  <section class="hero reveal" id="inicio" aria-label="Hero">
    <div class="hero-split">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="hero-phrase">{t('hero.headline2')}</span>
          <span class="hero-phrase text-terracota">{t('hero.headline3')}</span>
        </h1>
        <p class="hero-sub" set:html={t('hero.sub')}></p>
        <p class="hero-meta">
          <span class="price-group">
            <span class="current-price">Desde&nbsp;$300&nbsp;<small class="price-currency">USD</small></span>
          </span>
        </p>
        <div class="hero-actions">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="btn btn-lg btn-premium"
          >
            {ctaLabel}
          </a>
        </div>
        <p class="hero-b2b-tags">
          <span class="tag-b2b tag-outline">{t('hero.tag')}</span>
        </p>
      </div>

       <div class="hero-logo">
         <div class="hero-logo-ring">
           <div class="hero-isotype">
             <Logo size={280} ariaLabel="The Brand Crew" />
           </div>
         </div>
       </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimation() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const phrases = document.querySelectorAll('.hero-phrase');
    if (!phrases.length) return;

    // Collect all chars across all phrases
    const allChars: HTMLElement[] = [];
    phrases.forEach((phrase) => {
      const text = phrase.textContent || '';
      phrase.textContent = '';
      text.split('').forEach((char) => {
        const span = document.createElement('span');
        span.className = 'hero-char';
        span.textContent = char;
        span.style.opacity = '0';
        phrase.appendChild(span);
        allChars.push(span);
      });
    });

    if (prefersReducedMotion) {
      allChars.forEach(c => c.style.opacity = '1');
      return;
    }

    // Create cursor element
    const cursor = document.createElement('span');
    cursor.className = 'hero-cursor';
    phrases[phrases.length - 1].appendChild(cursor);

    // Typewriter: chars appear sequentially
    const tl = gsap.timeline({ delay: 0.5 });

    tl.to(allChars, {
      opacity: 1,
      duration: 0.05,
      stagger: 0.06,
      ease: 'none',
      onComplete: () => {
        // Fade out cursor after typing completes
        gsap.to(cursor, {
          opacity: 0,
          duration: 0.4,
          delay: 1.2,
          ease: 'power2.inOut',
        });
      },
    });

    document.addEventListener('astro:before-swap', () => {
      tl.kill();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initHeroAnimation);
  initHeroAnimation();
</script>