---
// Hero.astro — 50/50 split: left = pitch, right = logo composition
import Logo from './Logo.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getWhatsAppLink } from '../lib/whatsapp';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const waLink = getWhatsAppLink(lang);
const ctaLabel = t('hero.cta');
---

<div class="hero-problema-wrap" id="home">
  <section class="hero" id="inicio" aria-label="Hero">
    <div class="hero-split">
      <div class="hero-content">
        <h1 class="hero-title hero-anim" style="--hero-delay: 0.2s">
          <span class="hero-phrase">{t('hero.headline2')}</span>
          <span class="hero-phrase">{t('hero.headline3')}</span>
        </h1>
        <p class="hero-sub hero-anim" style="--hero-delay: 0.4s" set:html={t('hero.sub')}></p>
        <p class="hero-meta hero-anim" style="--hero-delay: 0.55s">
          <span class="price-group">
            <span class="current-price"><span class="price-from">{t('hero.priceFrom')}</span>&nbsp;${t('pricing.esencialPrice')}&nbsp;<small class="price-currency">USD</small></span>
          </span>
        </p>
        <div class="hero-actions hero-anim" style="--hero-delay: 0.7s">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="btn btn-lg btn-premium"
          >
            {ctaLabel}
          </a>
        </div>
        <p class="hero-b2b-tags hero-anim" style="--hero-delay: 0.85s">
          <span class="tag-b2b tag-outline">{t('hero.tag')}</span>
        </p>
      </div>

       <div class="hero-logo hero-anim-logo" style="--hero-delay: 1.0s">
         <div class="hero-logo-ring">
           <div class="hero-isotype">
             <Logo size={280} ariaLabel="The Brand Crew" />
           </div>
         </div>
       </div>
    </div>
  </section>
</div>

<style>
  .hero-anim {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-up 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    animation-delay: var(--hero-delay, 0s);
  }
  .hero-anim-logo {
    opacity: 0;
    transform: translateY(-30px) scale(0.92);
    animation: hero-logo-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--hero-delay, 1s);
  }
  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-logo-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-anim, .hero-anim-logo {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
