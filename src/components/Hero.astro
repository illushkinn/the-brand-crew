---
// Hero.astro — 50/50 split: left = pitch, right = logo composition
import Logo from './Logo.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getWhatsAppLink } from '../lib/whatsapp';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const waLink = getWhatsAppLink(lang);
const ctaLabel = t('hero.cta');
---

<div class="hero-problema-wrap" id="home">
  <div class="hero-splash" aria-hidden="true">
    <div class="hero-logo-ring">
      <div class="hero-isotype">
        <Logo size={160} ariaLabel="" />
      </div>
    </div>
  </div>
  <section class="hero reveal" id="inicio" aria-label="Hero">
    <div class="hero-split">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="hero-phrase">{t('hero.headline2')}</span>
          <span class="hero-phrase">{t('hero.headline3')}</span>
        </h1>
        <p class="hero-sub" set:html={t('hero.sub')}></p>
        <p class="hero-meta">
          <span class="price-group">
            <span class="current-price"><span class="price-from">{t('hero.priceFrom')}</span>&nbsp;${t('pricing.esencialPrice')}&nbsp;<small class="price-currency">USD</small></span>
          </span>
        </p>
        <div class="hero-actions">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="btn btn-lg btn-premium"
          >
            {ctaLabel}
          </a>
        </div>
        <p class="hero-b2b-tags">
          <span class="tag-b2b tag-outline">{t('hero.tag')}</span>
        </p>
      </div>

       <div class="hero-logo">
         <div class="hero-logo-ring">
           <div class="hero-isotype">
             <Logo size={280} ariaLabel="The Brand Crew" />
           </div>
         </div>
       </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimation() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      const logo = document.querySelector('.hero-logo');
      if (logo) gsap.set(logo, { opacity: 1 });
      ['.hero-title', '.hero-sub', '.hero-meta', '.hero-actions', '.hero-b2b-tags'].forEach(sel => {
        const el = document.querySelector(sel);
        if (el) gsap.set(el, { opacity: 1 });
      });
      return;
    }

    const runAnimation = () => {
      const contentElements = [
        { sel: '.hero-title', y: 30, delay: 0.2 },
        { sel: '.hero-sub', y: 20, delay: 0.4 },
        { sel: '.hero-meta', y: 15, delay: 0.55 },
        { sel: '.hero-actions', y: 10, delay: 0.7 },
        { sel: '.hero-b2b-tags', y: 10, delay: 0.85 },
      ];
      contentElements.forEach(({ sel, y, delay }) => {
        const el = document.querySelector(sel) as HTMLElement;
        if (el) {
          gsap.set(el, { opacity: 0, y });
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: 'power3.out',
            delay,
          });
        }
      });

      const logo = document.querySelector('.hero-logo') as HTMLElement;
      if (logo) {
        gsap.set(logo, { opacity: 0, y: -40, scale: 0.9 });
        gsap.to(logo, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.7,
          ease: 'back.out(1.4)',
          delay: 1.0,
        });
      }
    };

    setTimeout(runAnimation, 2400);
  }

  document.addEventListener('astro:page-load', initHeroAnimation);
  initHeroAnimation();
</script>