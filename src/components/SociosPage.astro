---
// SociosPage.astro — kit de precios minimalista para socios estratégicos (setters), /socios (both langs)
import type { Lang } from '../i18n/ui';
import { dictionaries } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCards from './PlanCards.astro';
import Footer from './Footer.astro';

interface Props {
  lang?: Lang;
  canonicalURL?: string;
}
const { lang = 'es', canonicalURL } = Astro.props;
const s = dictionaries[lang].socios;
---

<BaseLayout lang={lang} title={s.metaTitle} description={s.description} canonicalURL={canonicalURL} noindex={true}>
  <div class="socios-page-content">
    <section class="section socios" aria-label={s.label}>
      <header class="socios-head">
        <span class="section-label mono text-terracota">{s.label}</span>
        <h1 class="section-title socios-title" set:html={s.title}></h1>
      </header>

      <PlanCards lang={lang} showBadge={true} badge={s.badge} titleHeading="h2" />
    </section>
  </div>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .socios-page-content .section {
    padding-top: 7rem;
  }
  .socios-head {
    max-width: 640px;
    margin-bottom: 3rem;
  }
  .socios-title {
    margin-top: 0.75rem;
  }
</style>
