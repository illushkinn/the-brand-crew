---
// HomePage.astro — presentational shell for the home page (both langs)
import type { Lang } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Logo from './Logo.astro';
import CaseStudies from './CaseStudies.astro';
import Problema from './Problema.astro';
import ComoFunciona from './ComoFunciona.astro';
import Pricing from './Pricing.astro';
import FAQ from './FAQ.astro';
import Blog from './Blog.astro';
import About from './About.astro';
import Founders from './Founders.astro';
import CTA from './CTA.astro';
import Footer from './Footer.astro';
import ScrollToTop from './ScrollToTop.astro';

interface Props {
  lang?: Lang;
  canonicalURL?: string;
}
const { lang = 'es', canonicalURL } = Astro.props;
---

<BaseLayout lang={lang} canonicalURL={canonicalURL}>
  <div class="home-content">
    <Hero lang={lang} />
    <section class="hero-showcase" aria-hidden="true">
      <div class="hero-logo-ring">
        <div class="hero-isotype">
          <Logo size={280} ariaLabel="" />
        </div>
      </div>
    </section>
    <CaseStudies lang={lang} />
    <Problema lang={lang} />
    <ComoFunciona lang={lang} />
    <Pricing lang={lang} />
    <FAQ lang={lang} />
    <Blog lang={lang} />
    <About lang={lang} />
    <Founders lang={lang} />
  </div>
  <CTA lang={lang} />
  <div id="lets-start-anchor" style="scroll-margin-top: 40vh;"></div>
  <Footer lang={lang} />
  <ScrollToTop lang={lang} />
</BaseLayout>