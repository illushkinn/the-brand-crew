---
// AboutPage.astro — /nosotros (ES) y /en/about (EN)
// Manifesto anti-plantilla + Método V1 + prueba social (Google Business Profile).
// Shell igual que ServicioPage: BaseLayout + CTA + Footer + ScrollToTop + WhatsAppFloating.
import type { Lang } from '../i18n/ui';
import { dictionaries } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Founders from './Founders.astro';
import CTA from './CTA.astro';
import Footer from './Footer.astro';
import ScrollToTop from './ScrollToTop.astro';
import WhatsAppFloating from './WhatsAppFloating.astro';
import { GOOGLE_BUSINESS_URL, DOMAIN } from '../lib/constants';
import { getHomeLink, getPricingLink, getAboutLink } from '../lib/routing';

interface Props {
  lang?: Lang;
  canonicalURL?: string;
}
const { lang = 'es', canonicalURL } = Astro.props;
const a = dictionaries[lang].about;
const homeLink = getHomeLink(lang);
const pricingLink = getPricingLink(lang);

const aboutPath = canonicalURL ? canonicalURL.replace(DOMAIN, '') : getAboutLink(lang);
const breadcrumb = [
  { name: dictionaries[lang].seo.title, url: '/' },
  { name: dictionaries[lang].nav.about, url: aboutPath },
];

// Las uniones de arrays con literales distintos por idioma necesitan
// ancho explícito (mismo patrón que ServicioPage con fits/steps).
const points: ReadonlyArray<{ title: string; text: string }> = a.points;

// TODO(GBP): mientras GOOGLE_BUSINESS_URL sea '#', el CTA queda inerte y sin
// target _blank para no abrir una pestaña vacía. Ver comentario en constants.ts
// (decisión: CTA al perfil de Google en lugar de testimonios inventados).
const gbpPlaceholder = GOOGLE_BUSINESS_URL === '#';
---

<BaseLayout
  lang={lang}
  title={a.metaTitle}
  description={a.description}
  canonicalURL={canonicalURL}
  breadcrumb={breadcrumb}
>
  <div class="about-page-content">
    <section class="section about-hero reveal" aria-label={a.kicker}>
      <span class="section-label mono text-terracota">{a.kicker}</span>
      <h1 class="section-title">{a.title1} <span class="text-accent">{a.title2}</span></h1>
      <p class="section-sub">{a.lead}</p>
      <p class="section-sub">{a.p2}</p>
    </section>

    <section class="section about-stance reveal-stagger" aria-label={a.stanceKicker}>
      <span class="section-label mono text-terracota rv">{a.stanceKicker}</span>
      <h2 class="section-title rv">{a.stanceTitle1} <span class="text-accent">{a.stanceTitle2}</span></h2>
      <div class="como-funciona-grid rv">
        {points.map((point) => (
          <div class="glass-card como-funciona-card">
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section about-method reveal" aria-label={a.methodKicker}>
      <span class="section-label mono text-terracota">{a.methodKicker}</span>
      <h2 class="section-title">{a.methodTitle1} <span class="text-accent">{a.methodTitle2}</span></h2>
      <p class="section-sub">{a.methodText}</p>
      <div class="about-actions">
        <a href={pricingLink} class="btn btn-premium">{a.methodCta}</a>
        <a href={`${homeLink}#resultados`} class="about-link">{a.methodLink} →</a>
      </div>
    </section>

    {/* Founders reutilizado tal cual: cero duplicación de copy con la home. */}
    <Founders lang={lang} />

    {/* Prueba social: CTA al perfil de Google (ver GOOGLE_BUSINESS_URL).
        Sin testimonios: ver la decisión documentada en src/lib/constants.ts. */}
    <section class="section about-proof reveal" id="resenas" aria-label={a.proofKicker}>
      <span class="section-label mono text-terracota">{a.proofKicker}</span>
      <h2 class="section-title">{a.proofTitle1} <span class="text-accent">{a.proofTitle2}</span></h2>
      <p class="section-sub">{a.proofText}</p>
      <div class="about-actions">
        <a
          href={GOOGLE_BUSINESS_URL}
          class="btn btn-premium"
          target={gbpPlaceholder ? undefined : '_blank'}
          rel={gbpPlaceholder ? undefined : 'noopener'}
        >{a.proofCta}</a>
        <a href={`${homeLink}#casos`} class="about-link">{a.proofCases} →</a>
      </div>
    </section>
  </div>

  <CTA lang={lang} />
  <Footer lang={lang} />
  <ScrollToTop lang={lang} />
  <WhatsAppFloating lang={lang} />
</BaseLayout>

<style>
  .about-page-content .section {
    /* Igual que .pricing-page-content: despeja la navbar fija (~119px). */
    padding-top: 7rem;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .about-link {
    color: var(--crimson);
    text-decoration: underline;
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }
  .about-link:hover {
    opacity: 0.8;
  }
</style>
