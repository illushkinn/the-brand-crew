---
// PricingKit1.astro — Kit 1: Diseño web (Esencial, Crew, MVP)
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const esencialFeatures = [1, 2, 3, 4, 5, 6, 7].map((i) => t(`pricing.esencialF${i}`));
const crewFeatures = [1, 2, 3, 4, 5, 6, 7].map((i) => t(`pricing.crewF${i}`));
const mvpFeatures = [1, 2, 3, 4, 5, 6].map((i) => t(`pricing.mvpF${i}`));
---

<div class="pricing-kit">
  <h3 class="pricing-kit-title mono">{t('pricing.kit1Title')}</h3>
  <div class="pricing-grid">

     <!-- Esencial -->
     <article class="glass-card pricing-card-v2">
       <h3 class="pricing-card-title">{t('pricing.esencialTitle')}</h3>
       <p class="pricing-card-amount">${t('pricing.esencialPrice')} <small class="price-currency">USD</small></p>
       <p class="pricing-card-sub">{t('pricing.esencialSub')}</p>
       <p class="pricing-card-desc">{t('pricing.esencialDesc')}</p>
       <ul class="pricing-card-features">
         {
           esencialFeatures.map((f) => (
             <li>
               <Icon name="check" size={16} strokeWidth={2.5} />
               {f}
             </li>
           ))
         }
       </ul>
     </article>

     <!-- Crew — STAR CARD -->
     <article class="glass-card pricing-card-v2 is-star">
       <h3 class="pricing-card-title">{t('pricing.crewTitle')}</h3>
       <p class="pricing-card-amount">${t('pricing.crewPrice')} <small class="price-currency">USD</small></p>
       <p class="pricing-card-sub">{t('pricing.crewSub')}</p>
       <p class="pricing-card-desc">{t('pricing.crewDesc')}</p>
       <ul class="pricing-card-features">
         {
           crewFeatures.map((f) => (
             <li>
               <Icon name="check" size={16} strokeWidth={2.5} />
               {f}
             </li>
           ))
         }
       </ul>
     </article>

     <!-- MVP / E-commerce -->
     <article class="glass-card pricing-card-v2">
       <h3 class="pricing-card-title">{t('pricing.mvpTitle')}</h3>
       <p class="pricing-card-amount">${t('pricing.mvpPrice')} <small class="price-currency">USD</small></p>
       <p class="pricing-card-sub">{t('pricing.mvpSub')}</p>
       <p class="pricing-card-desc">{t('pricing.mvpDesc')}</p>
       <ul class="pricing-card-features">
         {
           mvpFeatures.map((f) => (
             <li>
               <Icon name="check" size={16} strokeWidth={2.5} />
               {f}
             </li>
           ))
         }
       </ul>
     </article>
  </div>
</div>
