---
// CookieBanner.astro — lightweight cookie consent banner (no libraries)
// Non-modal notice: never blocks the page (a full-screen scrim trapped the
// scroll-to-top / WhatsApp buttons below .page-content's stacking context).
// Persists choice in localStorage; rendered on every page via BaseLayout.
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getPrivacyLink } from '../lib/routing';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const privacyHref = getPrivacyLink(lang);
---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookies" aria-describedby="cookie-text">
  <p class="cookie-banner-text" id="cookie-text">
    <span>{t('cookieBanner.text')}</span>
    <a href={privacyHref} class="cookie-privacy-link">{t('cookieBanner.privacyLink')}</a>
  </p>
  <button class="btn btn-sm btn-premium" id="cookie-accept" type="button">{t('cookieBanner.accept')}</button>
</div>

<script>
  const CONSENT_KEY = 'tbc-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');

  // Brave Shields (cookies blocked / strict fingerprinting) makes localStorage
  // ACCESS throw SecurityError. Guard it: fall back to an in-memory flag so
  // the banner still renders and "Accept" still works for the session.
  let memoryConsent: string | null = null;

  function readConsent(): string | null {
    try {
      return localStorage.getItem(CONSENT_KEY) ?? memoryConsent;
    } catch {
      return memoryConsent;
    }
  }

  function writeConsent(value: string): void {
    memoryConsent = value;
    try {
      localStorage.setItem(CONSENT_KEY, value);
    } catch {
      // Storage blocked — consent lives only for this session.
    }
  }

  if (banner && !readConsent()) {
    banner.classList.add('visible');
  }

  acceptBtn?.addEventListener('click', () => {
    writeConsent('accepted');
    banner?.classList.remove('visible');
  });
</script>