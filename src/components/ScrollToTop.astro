---
// ScrollToTop.astro - Scroll to top button with visibility toggle
import type { Lang } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const label = lang === 'es' ? 'Volver arriba' : 'Back to top';
---

<button class="scroll-to-top" id="scrollToTop" aria-label={label} title={label}>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 22V4M5 11l7-7 7 7"/>
  </svg>
</button>