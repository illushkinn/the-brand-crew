---
// Problema.astro — 3 levels of awareness (Eugene Schwartz)
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section problema reveal-stagger" id="servicios" aria-label="The problem we solve">
  <span class="section-label mono text-terracota rv">{t('problema.kicker')}</span>
  <h2 class="section-title rv">{t('problema.title1')}<br><span class="text-terracota">{t('problema.title2')}</span>.</h2>
  <div class="problema-grid rv">
    <div class="glass-card problema-card tall">
      <h3>{t('problema.card1Title')}</h3>
      <p set:html={t('problema.card1Text')}></p>
    </div>
    <div class="glass-card problema-card">
      <h3>{t('problema.card2Title')}</h3>
      <p set:html={t('problema.card2Text')}></p>
    </div>
    <div class="glass-card problema-card">
      <h3>{t('problema.card3Title')}</h3>
      <p set:html={t('problema.card3Text')}></p>
    </div>
  </div>
</section>