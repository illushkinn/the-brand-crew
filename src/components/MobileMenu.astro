---
// MobileMenu.astro - Mobile navigation menu with clip-path animation
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const isHome = lang === 'es' ? '/' : '/en/';
---

<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Navigation menu" inert>
  <a href={`${isHome}#inicio`} class="mobile-link">{t('nav.home')}</a>
  <a href={`${isHome}#casos`} class="mobile-link">{t('nav.caseStudies')}</a>
  <a href={`${isHome}#faq`} class="mobile-link">{t('nav.faq')}</a>
  <a href={lang === 'es' ? '/pricing' : '/en/pricing'} class="mobile-link">{t('nav.pricing')}</a>
  <a href={`${isHome}#about`} class="mobile-link">{t('nav.about')}</a>
  <a href={`${isHome}#contacto`} class="mobile-link">{t('nav.start')}</a>
  <div class="mobile-lang-switcher" role="group" aria-label="Language">
    <a href={lang === 'es' ? Astro.url.pathname : Astro.url.pathname.replace('/en', '') || '/'} class={`lang-btn ${lang === 'es' ? 'is-active' : ''}`} aria-label="Español">ES</a>
    <span class="lang-separator" aria-hidden="true">|</span>
    <a href={lang === 'en' ? Astro.url.pathname : '/en' + Astro.url.pathname} class={`lang-btn ${lang === 'en' ? 'is-active' : ''}`} aria-label="English">EN</a>
  </div>
</div>
