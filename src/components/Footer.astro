---
// Footer.astro - Site footer with business info and links
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const socialLinks = [
  { name: 'Instagram', url: 'https://www.instagram.com/the.brand.crew/', icon: 'instagram' },
  { name: 'Facebook', url: 'https://www.facebook.com/profile.php?id=61594039034101', icon: 'facebook' },
  { name: 'X', url: 'https://x.com/thebrandcrew_', icon: 'x' },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer-card reveal">
    <div class="footer-card-content">
      <div class="footer-reciprocity">
        <Icon name="check" size={16} strokeWidth={2.5} />
        <span>{lang === 'es' ? 'Consultoría gratuita de 15 min — sin compromiso' : 'Free 15-min consultation — no commitment'}</span>
      </div>
      <p class="footer-cuit">{t('footer.madeBy')} {t('footer.friends')} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--terracota)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align:-2px;"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg></p>
      <div class="footer-links">
        <a href={lang === 'es' ? '/privacy' : '/en/privacy'} class="footer-link">{t('footer.privacy')}</a>
        <span class="footer-separator" aria-hidden="true"><svg width="4" height="4" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
        <a href={lang === 'es' ? '/terms' : '/en/terms'} class="footer-link">{t('footer.terms')}</a>
      </div>
      <div class="footer-social">
        {socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label={link.name}>
            <Icon name={link.icon} size={18} strokeWidth={2} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
