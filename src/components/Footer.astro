---
// Footer.astro - Site footer with business info and links
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';
import { getPrivacyLink, getTermsLink, getWebDesignLink, getPricingLink, PRICE_GUIDE_PATH, LOCAL_LANDING_PATH } from '../lib/routing';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const socialLinks = [
  { name: 'Instagram', url: 'https://www.instagram.com/the.brand.crew/', icon: 'instagram' as const },
  { name: 'Facebook', url: 'https://www.facebook.com/profile.php?id=61594039034101', icon: 'facebook' as const },
  { name: 'X', url: 'https://x.com/thebrandcrew_', icon: 'x' as const },
  { name: 'Substack', url: 'https://substack.com/@thebrandcrew', icon: 'substack' as const },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer-card reveal">
    <div class="footer-card-content">
      <div class="footer-social">
        {socialLinks.map((link) => (
          <a href={link.url} data-social={link.icon} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label={link.name}>
            <Icon name={link.icon} size={18} strokeWidth={2} />
          </a>
        ))}
      </div>
      <nav class="footer-links footer-links-seo" aria-label={lang === 'es' ? 'Servicios y guías' : 'Services'}>
        <a href={getWebDesignLink(lang)} class="footer-link">{t('footer.services')}</a>
        <span class="footer-separator" aria-hidden="true"><svg width="4" height="4" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
        <a href={getPricingLink(lang)} class="footer-link">{t('footer.pricing')}</a>
        {lang === 'es' && (
          <>
            <span class="footer-separator" aria-hidden="true"><svg width="4" height="4" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
            <a href={PRICE_GUIDE_PATH} class="footer-link">{t('footer.guide')}</a>
            <span class="footer-separator" aria-hidden="true"><svg width="4" height="4" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
            <a href={LOCAL_LANDING_PATH} class="footer-link">{t('footer.local')}</a>
          </>
        )}
      </nav>
      <div class="footer-links">
        <a href={getPrivacyLink(lang)} class="footer-link">{t('footer.privacy')}</a>
        <span class="footer-separator" aria-hidden="true"><svg width="4" height="4" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3.5"/></svg></span>
        <a href={getTermsLink(lang)} class="footer-link">{t('footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>
