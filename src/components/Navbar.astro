---
// Navbar.astro - Main navigation bar with desktop links, logo, and language switcher
import Logo from './Logo.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getHomeLink, getPricingLink } from '../lib/routing';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const isHome = getHomeLink(lang);
---

<header>
  <nav class="navbar" role="navigation" aria-label="Main navigation">
    <a href={isHome} class="navbar-brand" aria-label="The Brand Crew — home">
      <span class="logo-progress-ring" aria-hidden="true">
        <svg viewBox="0 0 80 80">
          <circle class="ring-bg" cx="40" cy="40" r="38" />
          <circle class="ring-fill" cx="40" cy="40" r="38" />
        </svg>
      </span>
      <Logo size={60} ariaLabel="The Brand Crew" />
    </a>
    <div class="nav-links">
      <a href={`${isHome}#crew`}>{t('nav.about')}</a>
      <a href={`${isHome}#resultados`}>{t('nav.howItWorks')}</a>
      <a href={`${isHome}#casos`}>{t('nav.cases')}</a>
      <a href={`${isHome}#faq`}>{t('nav.faq')}</a>
      <a href={getPricingLink(lang)}>{t('nav.pricing')}</a>
      <a href={`${isHome}#contacto`}>{t('nav.contact')}</a>
    </div>
    <div class="navbar-actions">
      <div class="lang-switcher" role="group" aria-label="Language">
        <a
          href={lang === 'es' ? Astro.url.pathname : Astro.url.pathname.replace('/en', '') || '/'}
          class={`lang-btn ${lang === 'es' ? 'is-active' : ''}`}
          aria-label="Español"
          aria-current={lang === 'es' ? 'true' : undefined}
        >ES</a>
        <span class="lang-separator" aria-hidden="true">|</span>
        <a
          href={lang === 'en' ? Astro.url.pathname : '/en' + Astro.url.pathname}
          class={`lang-btn ${lang === 'en' ? 'is-active' : ''}`}
          aria-label="English"
          aria-current={lang === 'en' ? 'true' : undefined}
        >EN</a>
      </div>
      <button class="hamburger" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>
