---
// Preloader component - Loading screen with 3D cube + bar
---

<div id="preloader-wrapper">
  <div id="preloader">
    <div class="preloader-center">
      <div class="diamond-wrap">
        <div class="cube-3d">
          <div class="cube-face cube-front"></div>
          <div class="cube-face cube-back"></div>
          <div class="cube-face cube-left"></div>
          <div class="cube-face cube-right"></div>
          <div class="cube-face cube-top"></div>
          <div class="cube-face cube-bottom"></div>
        </div>
        <div class="core-track"><div class="diamond-core"></div></div>
      </div>
    </div>
    <div class="preloader-glass"></div>
    <div id="preloader-ui">
      <div class="preloader-bar"><div class="preloader-fill" id="preloader-fill"></div></div>
    </div>
  </div>
</div>

<script is:inline>
  window.scrollTo(0,0);
  document.documentElement.classList.add('preloading');

  (function() {
    'use strict';
    var preloader = document.getElementById('preloader');
    var wrapper = document.getElementById('preloader-wrapper');
    if (!preloader) return;

    // Prevent scroll while preloader is active
    function preventScroll(e) { e.preventDefault(); }
    preloader.addEventListener('wheel', preventScroll, { passive: false });
    preloader.addEventListener('touchmove', preventScroll, { passive: false });

    // Pulse the diamond core once bar finishes
    setTimeout(function() {
      var coreTrack = preloader.querySelector('.core-track');
      if (coreTrack) coreTrack.classList.add('is-ready');
    }, 1500);

    // Auto-dismiss at 2s (cube animates ~1.5s, bar fills ~1.5s)
    setTimeout(function dismiss() {
      preloader.removeEventListener('wheel', preventScroll);
      preloader.removeEventListener('touchmove', preventScroll);
      document.documentElement.classList.remove('preloading');
      preloader.style.opacity = '0';
      preloader.style.transform = 'scale(0.97)';
      preloader.style.transition = 'opacity 0.4s ease, transform 0.4s ease';

      setTimeout(function() {
        preloader.style.display = 'none';
        if (wrapper) {
          wrapper.classList.add('is-dismissed');
          wrapper.style.display = 'none';
          wrapper.style.pointerEvents = 'none';
        }
        // Reveal elements already in viewport
        document.querySelectorAll('.reveal').forEach(function(el) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('visible');
          }
        });
      }, 450);
    }, 2000);
  })();
</script>
