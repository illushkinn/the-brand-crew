---
// Icon.astro — single source for inline SVG icons
// Usage: <Icon name="check" size={16} strokeWidth={2.5} />
interface Props {
  name: 'check' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'arrow-external';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 2.5, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  check: '<polyline points="20 6 9 17 4 12"></polyline>',
  'arrow-left': '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'arrow-up': '<path d="M12 22V4"/><path d="m5 11 7-7 7 7"/>',
  'arrow-external': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={paths[name]}
></svg>