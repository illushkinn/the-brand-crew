---
// LegalPage.astro — presentational shell for privacy & terms (both langs)
// Renders the dictionary content with one shared markup pattern, no inline styles.
import type { Lang } from '../i18n/ui';
import { dictionaries } from '../i18n/ui';
import { WHATSAPP_NUMBER, DOMAIN } from '../lib/constants';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  kind: 'privacy' | 'terms';
  lang: Lang;
}
const { kind, lang } = Astro.props;
const dict = dictionaries[lang];
const isES = lang === 'es';
const canonical = `${DOMAIN}${isES ? '' : '/en'}/${kind}`;
const backHref = isES ? '/' : '/en/';

type Section = { h2: string; body?: string; list?: string[]; emailSuffix?: boolean; contact?: boolean };
const sections: Section[] = kind === 'privacy'
  ? [
      { h2: dict.privacy.h2_1, body: dict.privacy.p1 },
      { h2: dict.privacy.h2_2, list: [dict.privacy.li2_1, dict.privacy.li2_2, dict.privacy.li2_3] },
      { h2: dict.privacy.h2_3, body: dict.privacy.p3 },
      { h2: dict.privacy.h2_4, body: dict.privacy.p4 },
      { h2: dict.privacy.h2_5, body: dict.privacy.p5 },
      { h2: dict.privacy.h2_6, body: dict.privacy.p6, emailSuffix: true },
      { h2: dict.privacy.h2_7, body: dict.privacy.p7 },
      { h2: dict.privacy.h2_8, body: dict.privacy.p8, contact: true },
    ]
  : [
      { h2: dict.terms.h2_1, body: dict.terms.p1 },
      { h2: dict.terms.h2_2, body: dict.terms.p2 },
      { h2: dict.terms.h2_3, list: [dict.terms.li3_1, dict.terms.li3_2, dict.terms.li3_3, dict.terms.li3_4] },
      { h2: dict.terms.h2_4, body: dict.terms.p4 },
      { h2: dict.terms.h2_5, body: dict.terms.p5 },
      { h2: dict.terms.h2_6, body: dict.terms.p6 },
      { h2: dict.terms.h2_7, list: [dict.terms.li7_1, dict.terms.li7_2, dict.terms.li7_3] },
      { h2: dict.terms.h2_8, body: dict.terms.p8 },
      { h2: dict.terms.h2_9, body: dict.terms.p9 },
      { h2: dict.terms.h2_10, body: dict.terms.p10 },
      { h2: dict.terms.h2_11, body: dict.terms.p11 },
      { h2: dict.terms.h2_12, body: dict.terms.p12, contact: true },
    ];

const c = kind === 'privacy' ? dict.privacy : dict.terms;
---

<BaseLayout
  title={`${c.title} | The Brand Crew`}
  description={c.description}
  canonicalURL={canonical}
  lang={lang}
>
  <div class="legal-main">
    <a href={backHref} class="legal-back">{c.backHome}</a>

    <h1 class="legal-title">{c.title}</h1>
    <p class="legal-updated">{c.updated}</p>

    <div class="glass-card legal-card">
      {
        sections.map((s) => (
          <section class="legal-block">
            <h2 class="legal-h2">{s.h2}</h2>
            {s.body && (
              <p class="legal-p">
                {s.body}
                {s.emailSuffix && <> <a href="mailto:hello@thebrandcrew.lat">hello@thebrandcrew.lat</a>.</>}
              </p>
            )}
            {s.list && (
              <ul class="legal-list">
                {s.list.map((li) => <li>{li}</li>)}
              </ul>
            )}
            {s.contact && (
              <p class="legal-p legal-contact">
                {c.email}: <a href="mailto:hello@thebrandcrew.lat">hello@thebrandcrew.lat</a><br />
                {c.whatsapp}: <a href={`https://wa.me/${WHATSAPP_NUMBER}`}>+54 9 11 2406-3009</a>
              </p>
            )}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>