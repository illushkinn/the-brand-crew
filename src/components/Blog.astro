---
// Blog section - Under construction placeholder
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="section blog reveal" id="blog" aria-label="Blog">
  <span class="section-label mono text-terracota">{t('blog.kicker')}</span>
  <h2 class="section-title">{t('blog.title1')}<br /><span class="text-verde">{t('blog.title2')}</span>.</h2>
  <div class="glass-card blog-construction">
    <div class="blog-icon">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--terracota)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
        <path d="m15 5 4 4"/>
      </svg>
    </div>
    <h3>{t('blog.comingSoon')}</h3>
    <p>{t('blog.comingSoonText')}</p>
  </div>
</section>