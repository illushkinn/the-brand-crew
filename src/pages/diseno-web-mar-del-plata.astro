---
// /diseno-web-mar-del-plata — landing local, corta (cluster "diseño web mar del plata").
// Solo ES (ver ES_ONLY_PATHS en lib/routing.ts). Estructura: hero → casos → precios → 3 FAQ → CTA.
// Copy propio y breve: no repetir lo que ya dicen la home ni /servicios/diseno-web.
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudies from '../components/CaseStudies.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import { DOMAIN, CALENDLY_URL } from '../lib/constants';
import { LOCAL_LANDING_PATH, getPricingLink } from '../lib/routing';
import { getWhatsAppLink } from '../lib/whatsapp';
import { dictionaries, getTranslation } from '../i18n/ui';

const canonicalURL = `${DOMAIN}${LOCAL_LANDING_PATH}`;
const p = dictionaries.es.pricing;

const title = 'Diseño web en Mar del Plata | Agencia local — The Brand Crew';
const description =
  'Webs a medida para negocios de Mar del Plata. Online en 7 días, desde USD 1.500. Nos juntamos en persona.';

const packs = [
  { name: p.esencialTitle, price: p.esencialPrice, desc: 'Landing de una página' },
  { name: p.crewTitle, price: p.crewPrice, desc: 'Web completa + marca' },
  { name: p.mvpTitle, price: p.mvpPrice, desc: 'Tienda online o pedidos' },
];

const faqs = [
  { q: '¿Nos podemos ver en persona?', a: 'Sí, estamos en Mar del Plata. Nos juntamos en tu local, en un café o por videollamada.' },
  { q: '¿Voy a aparecer en Google Maps?', a: 'Te dejamos la web lista para búsquedas locales y te ayudamos a armar tu perfil de Google Business, que es lo que te muestra en el mapa.' },
  { q: '¿Llego para la temporada?', a: 'Sí, si arrancás en noviembre. Una landing sale en una semana; una web completa, en dos.' },
];

const waLink = getWhatsAppLink('es', '¡Hola The Brand Crew! Tengo un negocio en Mar del Plata y quiero una web.');
const pricingLink = getPricingLink('es');

const breadcrumb = [
  { name: getTranslation('es', 'seo.title'), url: '/' },
  { name: 'Diseño web en Mar del Plata', url: LOCAL_LANDING_PATH },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diseño web en Mar del Plata',
    serviceType: 'Diseño web',
    url: canonicalURL,
    description,
    provider: { '@id': `${DOMAIN}/#business` },
    areaServed: { '@type': 'City', name: 'Mar del Plata' },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: p.esencialPrice.replace(/[.,]/g, ''),
      highPrice: p.mvpPrice.replace(/[.,]/g, ''),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout lang="es" title={title} description={description} canonicalURL={canonicalURL} breadcrumb={breadcrumb}>
  {schemas.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)}></script>)}

  <section class="legal-main mdp-hero">
    <span class="section-label mono text-terracota">Mar del Plata</span>
    <h1 class="legal-title">Diseño web en Mar del Plata</h1>
    <p class="mdp-sub">Webs a medida para negocios de la ciudad. Online en 7 días, desde USD {p.esencialPrice}.</p>
    <div class="mdp-actions">
      <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn btn-premium" data-calendly-url={CALENDLY_URL}>Agendar una llamada</a>
      <a href={waLink} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp</a>
    </div>
  </section>

  <CaseStudies lang="es" />

  <section class="legal-main mdp-block" aria-labelledby="mdp-precios">
    <h2 id="mdp-precios" class="legal-h2">Precios</h2>
    <ul class="mdp-packs">
      {packs.map((pack) => (
        <li>
          <span class="mdp-pack-name">{pack.name}</span>
          <span class="mdp-pack-desc">{pack.desc}</span>
          <span class="mdp-pack-price mono">USD {pack.price}</span>
        </li>
      ))}
    </ul>
    <a href={pricingLink} class="mdp-more">Ver qué incluye cada pack →</a>
  </section>

  <section class="legal-main mdp-block" aria-labelledby="mdp-faq">
    <h2 id="mdp-faq" class="legal-h2">Preguntas</h2>
    <div class="faq-list mdp-faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            {f.q}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="faq-chevron"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class="faq-answer"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
  </section>

  <CTA lang="es" />
  <Footer lang="es" />
  <ScrollToTop lang="es" />
  <WhatsAppFloating lang="es" />

  <script src="../scripts/faq.js"></script>
</BaseLayout>

<style>
  .mdp-hero {
    padding-top: 8.5rem;
    padding-bottom: 1rem;
  }
  .mdp-sub {
    color: var(--body-dim);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    margin: 0.75rem 0 1.75rem;
    max-width: 36ch;
  }
  .mdp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .mdp-block {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .mdp-packs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .mdp-packs li {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .mdp-pack-name {
    font-weight: 600;
    color: var(--headline);
  }
  .mdp-pack-desc {
    color: var(--body-dim);
  }
  .mdp-pack-price {
    color: var(--headline);
    white-space: nowrap;
  }
  .mdp-more {
    display: inline-block;
    margin-top: 1rem;
    color: var(--crimson);
    text-decoration: underline;
  }
  .mdp-faq {
    max-width: none;
    margin-top: 0;
  }
  /* El CTA final ocupa 100dvh en la home; en esta página corta, solo lo necesario. */
  :global(.cta-final) {
    height: auto;
    min-height: 0;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  @media (max-width: 520px) {
    .mdp-packs li {
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
    }
    .mdp-pack-desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
