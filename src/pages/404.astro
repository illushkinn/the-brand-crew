---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — The Brand Crew" lang="es">
  <Navbar lang="es" />
  <main style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
    <h1 style="font-size: clamp(4rem, 15vw, 8rem); font-family: var(--font-heading);">404</h1>
    <p style="font-size: 1.5rem; margin: 1rem 0 2rem; color: var(--body-dim);">Esta página no existe</p>
    <a href="/" class="btn btn-lg btn-premium">Volver al inicio</a>
  </main>
  <Footer lang="es" />
</BaseLayout>
