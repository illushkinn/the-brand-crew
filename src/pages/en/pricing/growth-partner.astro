---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PricingKit2 from '../../../components/PricingKit2.astro';
import CTA from '../../../components/CTA.astro';
import Footer from '../../../components/Footer.astro';
import ScrollToTop from '../../../components/ScrollToTop.astro';
import { DOMAIN } from '../../../lib/constants';

const lang = 'en';
---

<BaseLayout lang={lang} title="Growth Partner — The Brand Crew" description="Monthly growth partner: ongoing redesign, local SEO, community management and automations. Starting at $150 USD/mo." canonicalURL={`${DOMAIN}/en/pricing/growth-partner`}>
  <main id="main-content">
    <section class="section pricing reveal" id="precios" aria-label="Growth Partner Pricing">
      <span class="section-label mono text-terracota">Growth Partner</span>
      <h2 class="section-title">Your <span class="text-verde">growth</span> team.</h2>
      <p class="pricing-growth-hero-sub">Monthly <em>retainer</em> for businesses that need continuous evolution. Not a one-and-done website — a partner that works with you every month.</p>

      <PricingKit2 lang={lang} />

      <div class="pricing-growth-cta">
        <a href={lang === 'es' ? '/pricing' : '/en/pricing'} class="btn btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          Back to Web Design
        </a>
      </div>
    </section>
  </main>
  <CTA lang={lang} />
  <Footer lang={lang} />
  <ScrollToTop lang={lang} />
</BaseLayout>
