---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionaries } from '../i18n/ui';
import { WHATSAPP_NUMBER, DOMAIN } from '../lib/constants';

const c = dictionaries.es.terms;
---

<BaseLayout
  title={`${c.title} | The Brand Crew`}
  description="Términos y Condiciones de los servicios de diseño y desarrollo web de The Brand Crew. Condiciones de pago, plazos de proyecto y responsabilidades del cliente."
  canonicalURL={`${DOMAIN}/terms`}
  noindex={true}
  lang="es"
>
  <main id="main-content" style="padding: 4rem clamp(1.25rem, 5vw, 4rem); max-width: 900px; margin: 0 auto;">
    <a href="/" style="display: inline-block; margin-bottom: 2rem; color: var(--terracota); text-decoration: none; transition: opacity 0.2s;">{c.backHome}</a>

    <h1 style="font-size: clamp(2rem, 5vw, 2.5rem); margin-bottom: 0.5rem;">{c.title}</h1>
    <p style="color: var(--body-dim); margin-bottom: 2rem; font-size: 0.9rem;">{c.updated}</p>

    <div style="background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); padding: 2rem;">
      <h2 style="font-size: 1.5rem; margin-top: 0; margin-bottom: 1rem;">{c.h2_1}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p1}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_2}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p2}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_3}</h2>
      <p>{c.p3}</p>
      <ul style="margin-left: 1.5rem; margin-bottom: 1.5rem; margin-top: 0.5rem;">
        <li>{c.li3_1}</li>
        <li>{c.li3_2}</li>
        <li>{c.li3_3}</li>
        <li>{c.li3_4}</li>
      </ul>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_4}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p4}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_5}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p5}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_6}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p6}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_7}</h2>
      <p>{c.p7}</p>
      <ul style="margin-left: 1.5rem; margin-bottom: 1.5rem; margin-top: 0.5rem;">
        <li>{c.li7_1}</li>
        <li>{c.li7_2}</li>
        <li>{c.li7_3}</li>
      </ul>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_8}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p8}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_9}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p9}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_10}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p10}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_11}</h2>
      <p style="margin-bottom: 1.5rem;">{c.p11}</p>

      <h2 style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">{c.h2_12}</h2>
      <p style="margin-bottom: 0.5rem;">{c.p12}</p>
      <p style="margin-bottom: 0;">
        {c.email}: <a href="mailto:hello@thebrandcrew.lat" style="color: var(--terracota); text-decoration: underline;">hello@thebrandcrew.lat</a><br>
        {c.whatsapp}: <a href={`https://wa.me/${WHATSAPP_NUMBER}`} style="color: var(--terracota); text-decoration: underline;">+54 9 11 2406-3009</a>
      </p>
    </div>
  </main>
</BaseLayout>